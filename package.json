{
  "name": "charityworks",
  "version": "1.0.0",
  "private": true,
  "description": "CharityWorks — consignment auction items and fundraising consulting for nonprofits.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content-parity.ts",
    "check:admin": "tsx --conditions=react-server scripts/check-admin-forms.ts",
    "check:catalog": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-catalog.ts",
    "check:visual": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-visual-map.ts",
    "check:site": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-site.ts",
    "check:mfa": "tsx --conditions=react-server scripts/check-mfa.ts",
    "check:admin-nav": "tsx --conditions=react-server scripts/check-admin-nav.ts",
    "check:custom-pages": "tsx --conditions=react-server scripts/check-custom-pages.ts",
    "check:build-key": "tsx --conditions=react-server scripts/check-build-key.ts",
    "mfa": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/mfa-reset.ts",
    "check:uploads": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-uploads.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "migrate:hero-tiles": "tsx --env-file-if-exists=.env.local scripts/migrate-hero-tiles.ts",
    "migrate:merge-travel": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate-merge-travel.ts",
    "import:brochures": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-trip-brochures.ts",
    "migrate:faq-video": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/add-faq-video.ts",
    "migrate:hero-offer": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/add-hero-offer.ts",
    "migrate:video-to-auction-info": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/move-video-to-auction-info.ts",
    "create:newsletters": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-newsletters-page.ts"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.1.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.23.7",
    "typescript": "^5.7.2"
  }
}
