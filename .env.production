# Canonical origin for production builds.
#
# Drives canonical tags, OpenGraph URLs, the sitemap and the JSON-LD @id values
# (see src/content/site.ts). NEXT_PUBLIC_ variables are inlined at build time,
# so changing this requires a rebuild, not just a restart.
#
# Committed deliberately: this is a public, non-secret value, and keeping it in
# the repo means a build produces correct canonicals without depending on
# dashboard configuration. An environment variable set in the Vercel project
# settings still takes precedence over this file if you need to override it.
NEXT_PUBLIC_SITE_URL=https://charityworks.net

# ---------------------------------------------------------------------------
# OFF since launch. charityworks.net has pointed at Vercel since the DNS
# cutover (2026-10), so canonicals and the serving domain agree and the site
# should be indexed. See "Launch checklist" in the README.
# ---------------------------------------------------------------------------
# Set to true only for a deployment that must stay out of search results. It
# emits `noindex` on every page plus an X-Robots-Tag header, and withholds the
# sitemap from robots.txt.
#
# Crawling stays allowed on purpose: a crawler blocked by robots.txt never
# reads the noindex tag, so blocking would defeat the point.
SITE_NOINDEX=false
