# Canonical origin for production builds.
#
# Drives canonical tags, OpenGraph URLs, the sitemap and the JSON-LD @id values
# (see src/content/site.ts). NEXT_PUBLIC_ variables are inlined at build time,
# so changing this requires a rebuild, not just a restart.
#
# Committed deliberately: this is a public, non-secret value, and keeping it in
# the repo means a build produces correct canonicals without depending on
# dashboard configuration. An environment variable set in the Vercel project
# settings still takes precedence over this file if you need to override it.
NEXT_PUBLIC_SITE_URL=https://www.charityworks.net
